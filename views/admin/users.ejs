 <%- include('header.ejs') %>



      <main class="dashboard-content">
        <div class="container-fluid px-3 px-lg-4 py-4">
          <div class="page-heading">
            <div class="page-heading-copy">
              <span class="page-icon"><i class="bi bi-table" aria-hidden="true"></i></span>
              <div>
                <p class="eyebrow mb-1">Data</p>
                <h1 class="h3 mb-1">Tables</h1>
                <p class="text-muted mb-0">Use responsive, searchable tables for operational records.</p>
              </div>
            </div>
            
          </div>

          <section class="panel">
            <div class="panel-header">
                <div>
                    <h2 class="h5 mb-1 section-title"><i class="bi bi-table" aria-hidden="true"></i>
                        <span>Users Table</span>
                    </h2>
                    <p class="text-muted mb-0">Searchable responsive table for data.</p>
                </div>
                <input class="form-control form-control-sm table-search" type="search" placeholder="Search Users" data-table-search="ordersTable" aria-label="Search orders">
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0" id="ordersTable" data-searchable-table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Contact</th>
                            <th>Address</th>
                            <th>Email</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                         <% for(var i=0;i<users.length;i++){ %>

                        <tr>
                            <td ><%= i+1 %></td>
                            <td>    <%= users[i].name %></td>
                            <td>    <%= users[i].contact %></td>
                            <td>    <%= users[i].address %></td>
                            <td>    <%= users[i].email %></td>
                            <td class="text-end">
                                <form action="/admin/user_delete/<%= users[i].uid %>/<%= users[i].name %>" method="post"><button class="btn btn-light btn-sm" type="submit">Delete</button></form>
                                <form action="/admin/user_update/<%= users[i].uid %>" method="post"><button class="btn btn-light btn-sm" type="submit">Edit</button></form>
                            </td>
                        </tr>
                      <% } %>

                    </tbody>
                </table>
            </div>
          </section>
        </div>
      </main>

  <%- include('footer.ejs') %>

